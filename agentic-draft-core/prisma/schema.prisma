generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  isVerified        Boolean   @default(false)
  verificationToken String?   @unique
  createdAt         DateTime  @default(now())
  projects          Project[]
  preferences       UserPreferences?
}

model UserPreferences {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id])
  tone               String?  // e.g. "professional", "casual", "witty"
  length             String?  // e.g. "short", "medium", "long-form"
  hashtags           Boolean  @default(true)
  emojiUse           String?  // "none", "minimal", "frequent"
  customInstructions String?  @db.Text
  updatedAt          DateTime @updatedAt
}

model Project {
  id            String   @id @default(uuid())
  sourceContent String   @db.Text
  summary       String?  @db.Text
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  drafts        Draft[]
}

model Draft {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id])
  content      String   @db.Text
  qualityScore Float?
  userFeedback String?  @db.Text
  createdAt    DateTime @default(now())
}